# Data — large source files and generated artifacts.
# The pipeline artifacts are reproducible from notebook/04_cleaning.ipynb; their
# integrity is pinned by content fingerprints in tests/ rather than by tracking
# the binaries here (see tests/test_artifacts.py).
data/*.sqlite
data/*.parquet
data/*.baseline
# Cached score tables (W6). Derived from the panel by src/hex_panel.py, not
# inputs — the numbers they hold are reported in notebook/12 and quoted there.
data/*.csv
data/terraclimate_cache/
# Hex-grain TerraClimate checkpoints (W6, ~315M). Same rule as the region-grain
# cache above: reproducible from src/hex_climate.py, which resumes from whatever
# units are already present.
data/hex_climate_cache/
# MODIS vegetation-index checkpoints (W6). Same rule again: reduced hex means,
# reproducible from src/hex_ndvi.py, which resumes from whatever units are present.
data/hex_ndvi_cache/

# Ecoregion shapefiles (47M + 2.8M) — redistributable from the EPA, not ours to vendor.
data/us_eco_l3_state_boundaries/
data/ak_eco_l3/

# MTBS burned-area perimeters (W5) — redistributable from USGS/MTBS, not ours to
# vendor. Fetched by src/mtbs.py; the join key (MTBS_ID) lives in the FPA-FOD source.
data/mtbs_perimeters/

# MODIS vegetation-index cache (W5) — reduced hex means, reproducible from src/modis.py.
data/modis_cache/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# macOS
.DS_Store

# Office lock files. PowerPoint writes ~$Name.pptx beside an open deck and deletes
# it on close, so a tracked one is a snapshot of a moment the deck was open rather
# than anything about the project. One was committed in W7 and its later deletion
# showed up as a spurious change.
~$*.pptx
~$*.docx
~$*.xlsx

# Local, machine-specific Claude Code permissions (not shared).
.claude/settings.local.json

# Recorded presentation videos. The W7 deck recording is 137M, over GitHub's 100M
# hard limit, so committing one gets the push rejected — and removing it after the
# fact means rewriting history rather than a plain delete. Submitted through the
# course LMS, not the repo.
*.mp4
*.mov
